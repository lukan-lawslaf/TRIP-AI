OPEN_ROUTER_API_KEY=
GOOGLE_STUDIO_API_KEY=
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=

# ── Travel data ──────────────────────────────────────────
FLIGHT_API_KEY=
FLIGHT_DATA_API_KEY=
HOTEL_API_KEY=
WEATHER_API_KEY=
RESTAURANT_API_KEY=
TRAIN_INDIA_API_KEY=
